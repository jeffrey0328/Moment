# 阿里云 OSS
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：自定义 Endpoint。不填则使用 https://{bucket}.{region}.aliyuncs.com
OSS_ENDPOINT=
# 对象前缀，实际路径为 {prefix}/{userId}/
OSS_PREFIX=shiguang

# 本地开发时，Cookie 回写到 Vite；部署为同域服务时留空
APP_ORIGIN=http://localhost:5173

# 原生客户端跨域访问后端时允许的额外来源，逗号分隔；默认已包含官方壳来源
NATIVE_CORS_ORIGINS=

# 用于 AES-256-GCM 加密浏览器/原生壳中的登录会话；生产环境请生成至少 32 字节随机值
APP_SECRET=

# 可选。设置后注册同步账号必须填写该邀请码，避免公网后端被随意注册
SYNC_INVITE_CODE=

# 开发用：设为 fs 时不连 OSS，对象写到 DATA_DIR/objects。生产请删除此行
# SYNC_STORAGE=fs

# 账号表与开发用对象存储目录；多实例请挂载共享卷
DATA_DIR=./data

# 应用内更新：默认读取 GitHub 仓库 latest release。也可改为自建 JSON 地址
APP_UPDATE_REPO=jeffrey0328/Moment
# APP_UPDATE_FEED=https://example.com/moment-latest.json
# APP_UPDATE_GITHUB_TOKEN=

PORT=8787
MAX_UPLOAD_MB=512
