# 百度网盘开放平台应用配置
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
BAIDU_REDIRECT_URI=http://localhost:8787/api/auth/baidu/callback

# 本地开发时，OAuth 完成后回到 Vite；部署为同域服务时留空
APP_ORIGIN=http://localhost:5173

# 原生客户端跨域访问后端时允许的额外来源，逗号分隔；默认已包含官方壳来源
NATIVE_CORS_ORIGINS=

# 开放平台为你的应用分配/允许访问的应用目录
BAIDU_REMOTE_DIR=/apps/拾光记

# 用于 AES-256-GCM 加密浏览器中的 OAuth 令牌；生产环境请生成至少 32 字节随机值
APP_SECRET=

PORT=8787
MAX_UPLOAD_MB=512
